# Copia questo file in "stack.env" (o incollalo nelle Environment variables di
# Portainer) e compila i valori. NON committare stack.env.

# --- Gitea -------------------------------------------------------------------
# URL di Gitea raggiungibile DAL CONTAINER: usa IP e porta della VM, non localhost.
GITEA_URL=http://IP_DELLA_VM:3010
# Token Gitea in SOLA LETTURA (permessi: read:repository e read:organization).
# Se e' di un amministratore vede tutte le repo; altrimenti usa SOURCE_n_GITEA_TOKEN.
GITEA_TOKEN=

# --- API esposta a Home Assistant --------------------------------------------
# Segreto che Home Assistant manda come "Authorization: Bearer <API_TOKEN>".
# Generalo con:  openssl rand -hex 24
API_TOKEN=

# --- Opzioni (valori di default) ---------------------------------------------
CHECK_INTERVAL_MIN=60
# Un mirror e' "fermo" se non si aggiorna da piu' di queste ore (i mirror sono a 24h)
STALE_AFTER_HOURS=72
# Avvisa quando un token GitHub scade tra meno di questi giorni
TOKEN_WARN_DAYS=30
# VERIFY_TLS=false   # solo se GITEA_URL e' https con certificato non valido

# --- Sorgenti ----------------------------------------------------------------
# Una per ogni account personale o organizzazione GitHub (da 1 a 50).
# SOURCE_n_GH_ORG vuoto = account personale a cui appartiene il token.
# SOURCE_n_GITEA_OWNER = utente o organizzazione in Gitea (default: SOURCE_n_NAME).
# SOURCE_n_GH_TOKEN = token GitHub fine-grained, sola lettura (Contents: read).

SOURCE_1_NAME=utente-1
SOURCE_1_GH_ORG=
SOURCE_1_GITEA_OWNER=utente-1
SOURCE_1_GH_TOKEN=

SOURCE_2_NAME=organizzazione-1
SOURCE_2_GH_ORG=organizzazione-1
SOURCE_2_GITEA_OWNER=organizzazione-1
SOURCE_2_GH_TOKEN=
